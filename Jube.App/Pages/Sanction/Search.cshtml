@page
@model Search
@{
    Layout = "Shared/_Layout";
}

@section Scripts
{
    <script src="/js/Sanction/Search.js"></script>
}

<div class="fCStyle">
    <table id="ParamsTable" class="tTStyle">
        <tr>
            <td class="DescriptionCell-Style">
                <label for="MultiPartString">Multipart String</label>
            </td>
            <td>
                <input type="text" id="MultiPartString" class="k-textbox k-textboxmedium" name="MultiPartString"><span
                    class="k-invalid-msg" data-for="MultiPartString"></span>
            </td>
        </tr>
        <tr>
            <td class="DescriptionCell-Style">
                <label for="Distance">Distance</label>
            </td>
            <td style="padding-bottom: 30px;">
                <div id="Distance" class="slider" style="width: 400px;"></div>
            </td>
        </tr>
        <tr>
            <td class="DescriptionCell-Style">
                <label for="MaxDistanceRatio">Max Distance Ratio</label>
            </td>
            <td style="padding-bottom: 30px;">
                <div id="MaxDistanceRatio" class="slider" style="width: 400px;"></div>
            </td>
        </tr>
        <tr>
            <td class="DescriptionCell-Style">
                <label for="MaxCoverageRatio">Max Coverage Ratio</label>
            </td>
            <td style="padding-bottom: 30px;">
                <div id="MaxCoverageRatio" class="slider" style="width: 400px;"></div>
            </td>
        </tr>
    </table>
    <div class="bottomPaddedGeneral topPaddedGeneral">
        <input type="button" id="Check" value="Check">
    </div>
    <div id="Sanctions"></div>
    <div class="topPaddedGeneral">
        <label>Total Aggregation</label>
        <div id="AggregationsTotal"></div>
    </div>
    <div class="topPaddedGeneral">
        <label>Aggregation by Source</label>
        <div id="AggregationsBySource"></div>
    </div>
</div>