@page
@{
    Layout = "Shared/_Layout";
}

@section Scripts
{
    <script src="/js/Administration/SanctionsLoader.js"></script>
}

<div class="fCStyle">
    <div id="Template">
        <form id="Form" class="k-form">
            <table id="TemplateTable" class="tTStyle">
                <tr>
                    <td>
                        <label for="SanctionEntrySource">Sanction Entry Source</label>
                    </td>
                    <td>
                        <input id="SanctionEntrySource" name="SanctionEntrySource">
                    </td>
                </tr>
                <tr>
                    <td>
                        <label for="Files" class="k-checkbox-label">Import</label>
                    </td>
                    <td>
                        <input name="Files" id="Files" type="file" aria-label="Files"/>
                    </td>
                </tr>
            </table>
        </form>
    </div>
</div>