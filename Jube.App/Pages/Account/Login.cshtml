@page
@using Jube.DynamicEnvironment
@model LoginModel
@inject DynamicEnvironment DynamicEnvironment
<script src="/js/Account/PasswordStrength.js"></script>
<script src="/js/Account/Encryption.js"></script>
<script src="/js/Account/Authentication.js"></script>

<script>
    const negotiateAuthentication = @(DynamicEnvironment.AppSettings("NegotiateAuthentication")
                                      .Equals("True", StringComparison.OrdinalIgnoreCase) ? "true" : "false");

    const mfa = @(DynamicEnvironment.AppSettings("EnableMultifactorAuthentication")
                  .Equals("True", StringComparison.OrdinalIgnoreCase) ? "true" : "false");

    const passwordAsymmetricEncryption = @(DynamicEnvironment.AppSettings("PasswordAsymmetricEncryption")
                                           .Equals("True", StringComparison.OrdinalIgnoreCase) ? "true" : "false");

    const passwordAsymmetricEncryptionPublicKey = "@DynamicEnvironment.AppSettings("PasswordAsymmetricEncryptionPublicKey")";
</script>

<br/>
<form id="FormAuthenticate" style="display:none;">
    <table id="AuthenticationTable" class="tTStyle">
        <tr>
            <td>
                <label for="UserName">User Name</label>
            </td>
            <td>
                <input type="text" id="UserName" name="UserName" class="k-textbox" autocomplete="off">
            </td>
        </tr>
        <tr>
            <td>
                <label for="Password">Password</label>
            </td>
            <td>
                <input type="password" id="Password" name="Password" class="k-textbox" autocomplete="off">
            </td>
        </tr>
        <tr id="MfaRow" style="display:none;">
            <td>
                <label for="Mfa">MFA Token</label>
            </td>
            <td>
                <input type="text" id="Mfa" name="Mfa" class="k-textbox" autocomplete="off"
                       inputmode="numeric" maxlength="8">
            </td>
        </tr>
    </table>
</form>
<div class="topPaddedGeneral bottomPaddedGeneral">
    <br/>
    <button id="Login" type="submit">Log in</button>
    <span id="MessageAuthenticate"></span>
</div>
<template id="PasswordResetTemplate">
    <div id="PasswordResetDiv">
        <form id="FormChange">
            <br/>
            <table id="PasswordResetTable" class="tTStyle">
                <tr>
                    <td>
                        <label for="NewPassword">New Password</label>
                    </td>
                    <td>
                        <input type="password" id="NewPassword" name="NewPassword" class="k-textbox" autocomplete="off">
                    </td>
                </tr>
                <tr>
                    <td>
                        <label for="VerifyNewPassword">Verify New Password</label>
                    </td>
                    <td>
                        <input type="password" id="VerifyNewPassword" name="VerifyNewPassword" class="k-textbox"
                               autocomplete="off">
                    </td>
                </tr>
            </table>
        </form>
        <br/>
        <div class="topPaddedGeneral">
            <button id="Change" type="submit">Change Password and Login</button>
            <span id="MessageChange"></span>
        </div>
    </div>
</template>
<div id="PasswordResetContainer"></div>