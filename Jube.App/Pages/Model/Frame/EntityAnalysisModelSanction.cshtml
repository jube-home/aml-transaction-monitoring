@page
@model EntityAnalysisModelSanction

@{
    Layout = null;
}

<script src="/js/CRUD.js"></script>
<script src="/js/Model/Frame/EntityAnalysisModelSanction.js"></script>

<form id="Form" class="k-form">
    <body>
    <div class="fCStyle">
        <table id="TemplateTable" class="tTStyle">
            <tr>
                <td>
                    <label for="Name">Name</label>
                </td>
                <td>
                    <input type="text" id="Name" class="k-textbox large" name="Name"/>
                    <span class="k-invalid-msg" data-for="Name"></span>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="Active" class="k-checkbox-label">Active</label>
                </td>
                <td>
                    <input id="Active" type="checkbox"/>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="Locked" class="k-checkbox-label">Locked</label>
                </td>
                <td>
                    <input id="Locked" type="checkbox"/>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="MultipartStringDataName">Multipart String</label>
                </td>
                <td>
                    <select id="MultipartStringDataName"></select>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="AggregationTypeId">Aggregation Type</label>
                </td>
                <td>
                    <select id="AggregationTypeId"></select>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="Distance">Distance</label>
                </td>
                <td class="sliderFooter" style="padding-bottom: 30px;">
                    <div id="Distance" style="width: 400px;"></div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="MaxDistanceRatio">Max Distance Ratio</label>
                </td>
                <td class="sliderFooter" style="padding-bottom: 30px;">
                    <div id="MaxDistanceRatio" style="width: 400px;"></div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="MaxCoverageRatio">Max Coverage Ratio</label>
                </td>
                <td class="sliderFooter" style="padding-bottom: 30px;">
                    <div id="MaxCoverageRatio" style="width: 400px;"></div>
                </td>
            </tr>
            <tr>
                <td class="DescriptionCell-Style">
                    <label for="CacheIntervalType">Cache Interval Type</label>
                </td>
                <td>
                    <ul id="CacheIntervalType" class="fieldlist">
                        <li>
                            <input type="radio" class="k-radio" name="CacheInterval" id="CacheIntervalSecond"
                                   value="s"/>
                            <label class="k-radio-label" for="CacheIntervalSecond">Seconds</label>
                        </li>
                        <li>
                            <input type="radio" class="k-radio" name="CacheInterval" id="CacheIntervalMin" value="n"/>
                            <label class="k-radio-label" for="CacheIntervalMin">Minutes</label>
                        </li>
                        <li>
                            <input type="radio" class="k-radio" name="CacheInterval" id="CacheIntervalHour"
                                   checked="checked" value="h"/>
                            <label class="k-radio-label" for="CacheIntervalHour">Hours</label>
                        </li>
                        <li>
                            <input type="radio" class="k-radio" id="CacheIntervalDay" name="CacheInterval" value="d"/>
                            <label class="k-radio-label" for="CacheIntervalDay">Days</label>
                        </li>
                    </ul>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="CacheValue">Cache Interval Value</label>
                </td>
                <td>
                    <input id="CacheValue" value="1"/>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="ReportTable">Report Table</label>
                </td>
                <td>
                    <input id="ReportTable" type="checkbox"/>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="ResponsePayload">Response Payload</label>
                </td>
                <td>
                    <input id="ResponsePayload" type="checkbox"/>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="Version">Version</label>
                </td>
                <td>
                    <div id="Version"></div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="CreatedUser">User Created</label>
                </td>
                <td>
                    <div id="CreatedUser"></div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="CreatedDate">Created Date</label>
                </td>
                <td>
                    <div id="CreatedDate"></div>
                </td>
            </tr>
        </table>
        <div class="footerStyle">
            <div id="ErrorMessage" class="errorMessage"></div>
            <button type="button" id="Add" class="ButtonDefault">Add</button>
            <button type="button" id="Update" class="ButtonDefault">Update</button>
            <button type="button" id="Delete" class="ButtonDefault">Delete</button>
        </div>
    </div>
    </body>
</form>