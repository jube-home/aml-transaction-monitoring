@page
@model EntityAnalysisModelGatewayRule

@{
    Layout = null;
}

<script src="/js/BuilderCoder.js"></script>
<script src="/js/CRUD.js"></script>
<script src="/js/Model/Frame/EntityAnalysisModelGatewayRule.js"></script>

<form id="Form" class="k-form">
    <body>
    <div class="fCStyle">
        <table id="TemplateTable" class="tTStyle">
            <tr>
                <td>
                    <label for="Name">Name</label>
                </td>
                <td>
                    <input type="text" id="Name" class="k-textbox large" name="Name"/>
                    <span class="k-invalid-msg" data-for="Name"></span>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="Active" class="k-checkbox-label">Active</label>
                </td>
                <td>
                    <input id="Active" type="checkbox"/>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="Locked" class="k-checkbox-label">Locked</label>
                </td>
                <td>
                    <input id="Locked" type="checkbox"/>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="Priority">Priority</label>
                </td>
                <td>
                    <input id="Priority" value="0"/>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="rule">Rule</label>
                </td>
                <td>
                    <div id="rule"></div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="GatewaySample">Gateway Sample</label>
                </td>
                <td>
                    <input id="GatewaySample" value="100"/>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="MaxResponseElevation">Response Elevation Limit</label>
                </td>
                <td>
                    <input id="MaxResponseElevation" value="0"/>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="Counters">Counters</label>
                </td>
                <td>
                    <div id="Counters"></div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="LastCounters">Last Counters</label>
                </td>
                <td>
                    <div id="LastCounters"></div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="Version">Version</label>
                </td>
                <td>
                    <div id="Version"></div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="CreatedUser">User Created</label>
                </td>
                <td>
                    <div id="CreatedUser"></div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="CreatedDate">Created Date</label>
                </td>
                <td>
                    <div id="CreatedDate"></div>
                </td>
            </tr>
        </table>
        <div class="footerStyle">
            <div id="ErrorMessage" class="errorMessage"></div>
            <button type="button" id="Add" class="ButtonDefault">Add</button>
            <button type="button" id="Update" class="ButtonDefault">Update</button>
            <button type="button" id="Delete" class="ButtonDefault">Delete</button>
            <button type="button" id="Reset" class="ButtonDefault">Reset Counters</button>
        </div>
    </div>
    </body>
</form>