@page
@model EntityAnalysisModelSample
@{
    Layout = "Shared/_Layout";
}

<script src="/js/Model/EntityAnalysisModelSample.js"></script>

<form id="Form" class="k-form">
    <body>
    <div class="fCStyle">
        <table id="TemplateTable" class="tTStyle">
            <tr>
                <td>
                    <label for="EntityAnalysisModel">Model</label>
                </td>
                <td>
                    <select id="EntityAnalysisModel">
                    </select>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="DateFrom">Date From</label>
                </td>
                <td>
                    <input type="text" id="DateFrom"/>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="DateTo">Date to</label>
                </td>
                <td>
                    <input type="text" id="DateTo"/>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="Sample">Sample</label>
                </td>
                <td>
                    <input type="text" id="Sample"/>
                </td>
            </tr>
        </table>
        <div class="footerStyle">
            <div class="bottomPaddedGeneral">
                <div id="ErrorMessage" class="errorMessage"></div>
                <button type="button" id="Download" class="ButtonDefault">Download</button>
            </div>
        </div>
    </div>
    </body>
</form>